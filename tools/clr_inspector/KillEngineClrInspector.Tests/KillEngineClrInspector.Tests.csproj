<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Auto-tests bout-en-bout du MVP ClrMD (candidat 8, docs/POWER_UP_ROADMAP.md).
    Lance de vrais processus (KillEngineClrTestTarget.exe et
    KillEngineClrInspector.exe, tous deux construits par les projets voisins
    de tools/clr_inspector/ et tests/clr_targets/), les pilote via leurs pipes
    JSON-RPC reels, pas de mock, la meme sequence que la validation
    manuelle documentee dans docs/KILLENGINE_CLR_INSPECTOR_SPEC.md.
    Voir README.md a cote pour comment lancer ces tests.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
