<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helper .NET dedie au candidat 8 (docs/POWER_UP_ROADMAP.md, ClrMD/SOS) :
    inspection d'objets manages via Microsoft.Diagnostics.Runtime (ClrMD).
    KillEngine.exe (C++/Qt) est natif et ne peut pas heberger ClrMD
    directement, ce process est donc lance en sous-processus et pilote via un
    named pipe JSON-RPC (meme protocole que
    apps/desktop/automation_pipe_server.h). Voir
    docs/KILLENGINE_CLR_INSPECTOR_SPEC.md pour le detail d'architecture.

    Publie self-contained a terme (dotnet publish -r win-x64 avec
    SelfContained=true) pour ne pas exiger de runtime .NET installe chez
    l'utilisateur final ; build framework-dependent pendant le developpement
    pour des iterations rapides.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KillEngineClrInspector</AssemblyName>
    <RootNamespace>KillEngine.ClrInspector</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.732401" />
  </ItemGroup>

</Project>
