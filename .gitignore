# KillEngine .gitignore

# Build directories
build/
dist/
out/
cmake-build-*/
[Bb]in/
[Oo]bj/

# IDE files
.vs/
.vscode/
*.user
*.suo
*.sln
*.vcxproj*
.idea/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# Qt generated
*.qm
moc_*
qrc_*
ui_*

# Node / Vue
ui/node_modules/
ui/dist/
ui/.env.local

# Python (dev tools)
__pycache__/
*.pyc
.venv/
venv/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Models (too large for git) — actual runtime layout is model/<ai-name>/*.gguf
# (singular), not models/ (plural). The plural pattern below never matched
# anything: model/qwen/*.gguf (~1.4 GB) was sitting untracked and un-ignored.
model/**/*.gguf
model/**/*.bin
model/**/*.partial
models/*.gguf
models/*.bin
models/*.partial

# Downloaded archives / local vendor binaries
downloads/
third_party/llama.cpp/
runtime/lua/*
!runtime/lua/README.md

# vcpkg
vcpkg_installed/

# Logs
*.log
logs/
message entre ia.md

# Crash dumps
*.dmp
*.mdmp

# Temporary
tmp/
temp/

# Local agent config / personal notes (machine-specific, not shared)
.claude/
suite reboot.txt

# Benchmark results (machine-specific)
docs/benchmark-results/
docs/manual-validation-results/
diagnostics/
