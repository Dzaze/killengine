# KillEngine .gitignore

# Build directories
build/
out/
cmake-build-*/
[Bb]in/
[Oo]bj/

# IDE files
.vs/
.vscode/
*.user
*.suo
*.sln
*.vcxproj*
.idea/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# Qt generated
*.qm
moc_*
qrc_*
ui_*

# Node / Vue
ui/node_modules/
ui/dist/
ui/.env.local

# Python (dev tools)
__pycache__/
*.pyc
.venv/
venv/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Models (too large for git)
models/*.gguf
models/*.bin
models/*.partial

# Downloaded archives / local vendor binaries
downloads/
third_party/llama.cpp/

# vcpkg
vcpkg_installed/

# Logs
*.log
logs/
message entre ia.md

# Crash dumps
*.dmp
*.mdmp

# Temporary
tmp/
temp/
